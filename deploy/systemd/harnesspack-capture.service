[Unit]
Description=HarnessPack server-side snapshot capture
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=harnesspack
Group=harnesspack
WorkingDirectory=/opt/harnesspack
Environment=APP_ROOT=/opt/harnesspack
Environment=HOME=/var/lib/harnesspack
Environment="GIT_SSH_COMMAND=ssh -i /var/lib/harnesspack/.ssh/harnesspack_deploy -o IdentitiesOnly=yes -o UserKnownHostsFile=/var/lib/harnesspack/.ssh/known_hosts"
EnvironmentFile=/etc/harnesspack.env
ExecStart=/usr/bin/bash /opt/harnesspack/deploy/scripts/capture.sh
TimeoutStartSec=1800
Nice=10
